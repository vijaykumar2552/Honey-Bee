# ============================================================================
# HoneyChain environment configuration
#
#   cp .env.example .env      then edit .env with real values
#
# .env is git-ignored. NEVER commit real secrets, and never ship a .env inside
# a distributable archive.
# ============================================================================

# ---- RUNTIME MODE ----------------------------------------------------------
# Development/demo mode generates and persists secure local fallback secrets
# under instance/.dev-secrets.json when the three secret keys below are absent.
# Set HONEYCHAIN_ENV=production in deployed environments; production requires
# explicit secrets and keeps the legacy shared-secret webhook disabled.
HONEYCHAIN_ENV=development

# ---- SECURITY KEYS ----------------------------------------------------------
# Shared secret for the telemetry webhook. Used for both the
# X-HoneyChain-Signature HMAC-SHA256 header and the ?auth= query parameter.
# Generate a strong one:   python -c "import secrets; print(secrets.token_hex(32))"
# Optional in development/demo mode; required in production.
HONEYCHAIN_WEBHOOK_SECRET=change-this-secret

# Secret for signing user-authentication bearer tokens (honeychain.auth).
# Separate from the webhook secret above -- rotate independently.
# Generate a strong one:   python -c "import secrets; print(secrets.token_hex(32))"
# Optional in development/demo mode; required in production.
HONEYCHAIN_AUTH_SECRET=change-this-secret-too

# How long a login token stays valid, in seconds. Default: 1 hour.
HONEYCHAIN_AUTH_TOKEN_TTL=3600

# --- Intelligence (Phase 7) --------------------------------------------------
# Deterministic safety-rule overrides (defaults shown). Invalid, non-finite,
# out-of-range or inverted values make the app REFUSE TO START (fail closed).
# HONEYCHAIN_RULE_TEMP_CRITICAL_LOW=30
# HONEYCHAIN_RULE_TEMP_CRITICAL_HIGH=38
# HONEYCHAIN_RULE_WEIGHT_CRITICAL_LOW=5
# HONEYCHAIN_RULE_HUMIDITY_WARNING_LOW=40
# HONEYCHAIN_RULE_HUMIDITY_WARNING_HIGH=85
# Highest status the ML model may raise a reading to (WARNING or CRITICAL).
# Keep WARNING while the model is trained on synthetic data only.
HONEYCHAIN_ML_MAX_ESCALATION=WARNING
# Robust modified z-score outlier flag (Iglewicz & Hoaglin cut-off 3.5).
HONEYCHAIN_SENSOR_ROBUST_Z=3.5
HONEYCHAIN_SENSOR_ROBUST_MIN_HISTORY=20

# --- Per-device IoT authentication (Phase 4) -------------------------------
# Master key every device credential is derived from. The server stores no
# raw device secrets. Changing this invalidates EVERY device credential
# (they fail closed) -- re-provision/rotate devices after changing it.
# Generate:   python -c "import secrets; print(secrets.token_hex(32))"
# Optional in development/demo mode; required in production.
HONEYCHAIN_DEVICE_MASTER_KEY=change-this-device-master-key
# Signed request timestamp must be within this many seconds of server time.
HONEYCHAIN_DEVICE_MAX_SKEW=300
# Per-reading device clock: allowed future drift / allowed buffered backfill.
HONEYCHAIN_DEVICE_FUTURE_TOLERANCE=300
HONEYCHAIN_DEVICE_MAX_BACKFILL=604800
# Device-silence alerting: OFFLINE after (expected interval x multiplier).
HONEYCHAIN_DEVICE_EXPECTED_INTERVAL=300
HONEYCHAIN_DEVICE_SILENCE_MULTIPLIER=3

# Pre-Phase-4 fleet-wide shared-secret webhook (/api/firebase/webhook).
# Enabled by default in development/demo mode for simulator compatibility.
# Production defaults to false; use the per-device endpoint instead.
HONEYCHAIN_LEGACY_WEBHOOK_ENABLED=true


# Absolute base URL embedded into batch QR codes. Must be reachable by the
# phone scanning the jar -- "localhost" only works on the same machine.
HONEYCHAIN_PUBLIC_BASE_URL=http://localhost:5000

# ---- OPTIONAL: server ------------------------------------------------------
HONEYCHAIN_HOST=0.0.0.0
HONEYCHAIN_PORT=5000
HONEYCHAIN_DEBUG=false
HONEYCHAIN_LOG_LEVEL=INFO
HONEYCHAIN_DB_PATH=instance/honeychain.db
HONEYCHAIN_MAX_CONTENT_LENGTH=1048576
HONEYCHAIN_LATEST_LIMIT=20

# ---- OPTIONAL: server-sent events -----------------------------------------
HONEYCHAIN_SSE_KEEPALIVE=15
HONEYCHAIN_SSE_QUEUE_SIZE=100
HONEYCHAIN_SSE_MAX_CLIENTS=200

# ---- OPTIONAL: sudden weight-loss (swarming) detector ----------------------
HONEYCHAIN_SWARM_DROP_KG=2.0
HONEYCHAIN_SWARM_WINDOW_SECONDS=60

# ---- OPTIONAL: simulator defaults -----------------------------------------
HONEYCHAIN_WEBHOOK_URL=http://localhost:5000/api/firebase/webhook
HONEYCHAIN_AUTH_MODE=header

# ---- OPTIONAL: Ethereum (Sepolia) anchoring -------------------------------
# Entirely opt-in. The local SHA-256 ledger works without any of this.
HONEYCHAIN_CHAIN_ANCHOR=false
# Only Merkle roots over the chain-event log are anchored (one transaction per
# checkpoint). POST /api/chain/checkpoints then /api/chain/checkpoints/submit.
# RPC_URL=https://rpc-amoy.polygon.technology   (or http://127.0.0.1:8545 for local Hardhat)
# CHAIN_ID=80002                                 must equal the RPC endpoint's chain id
# CONTRACT_ADDRESS=0xYourDeployedContractAddress
# PRIVATE_KEY=0xYourFundedTestnetPrivateKey     <-- NEVER commit a real key
HONEYCHAIN_CHECKPOINT_MAX_ATTEMPTS=5
HONEYCHAIN_CHAIN_TX_TIMEOUT=120

# ---- OPTIONAL: Firebase Admin pull bridge ---------------------------------
HONEYCHAIN_FIREBASE=false
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# FIREBASE_CREDENTIALS_PATH=/secure/path/firebase-service-account.json

# --- Additional tuning (all optional; defaults shown) --------------------------
# Sensor data-quality heuristics (honeychain/sensor_faults.py)
HONEYCHAIN_SENSOR_FLATLINE_COUNT=10
HONEYCHAIN_SENSOR_MAX_TEMP_JUMP_C=8.0
HONEYCHAIN_SENSOR_MAX_HUMIDITY_JUMP=30.0
HONEYCHAIN_SENSOR_JUMP_WINDOW=120
# Suspicious-scan signals (honeychain/authority.py, honeychain/consumer.py)
HONEYCHAIN_SIGNAL_FORGERY_ATTEMPTS=3
HONEYCHAIN_SIGNAL_SCAN_VELOCITY_24H=10
# Per-client-address rate limits (honeychain/ratelimit.py; in-process, per worker)
HONEYCHAIN_PUBLIC_VERIFY_PER_MINUTE=30
HONEYCHAIN_LOGIN_PER_MINUTE_PER_ADDRESS=20
